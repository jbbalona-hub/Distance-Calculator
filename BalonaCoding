a=input('Do you want to convert another distance? (yes/no) :')
if a=='yes':
    r=float(input('Enter another distance in kilometer:'))
    q=r*conversionfactor
    print('Distance in Miles',q)
#Needed to end the program
else:
    print('Program Ended.')
